# Copy this file to .env and adjust the values before starting the FastAPI server.
#
# API_TOKEN must match the token configured in the Android application's
# local.properties file so that requests can be authenticated.
API_TOKEN=local_dev_token

# Provide an OpenAI API key to enable the /action and /generate endpoints.
# Without this key the server will still run, but these endpoints will return
# an informative error instructing you to configure the key.
# OPENAI_API_KEY=sk-your-key

# Set to 0 to force EasyOCR to run on CPU. When unset the server will try the
# GPU first and automatically fall back to CPU if the initialization fails.
# EASYOCR_GPU=0
